# ============================================
# LLMore.id — Environment Configuration
# ============================================

# --- Database (PostgreSQL) ---
DB_DATABASE=llmore
DB_USERNAME=llmore
DB_PASSWORD=secret

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Laravel Backend ---
APP_NAME=LLMore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/google/callback

# --- KlikQRIS ---
KLIKQRIS_API_KEY=your-klikqris-api-key
KLIKQRIS_MERCHANT_ID=your-klikqris-merchant-id
KLIKQRIS_WEBHOOK_URL=http://localhost:8000/api/payment/webhook

# --- AskCodi ---
ASKCODI_API_URL=https://api.askcodi.com/v1
ASKCODI_API_KEY=your-askcodi-api-key

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# --- Gateway ---
GATEWAY_PORT=3001
