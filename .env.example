# ============================================
# LLMora.id — Environment Configuration
# ============================================

# --- Database (PostgreSQL) ---
DB_DATABASE=llmore
DB_USERNAME=llmore
DB_PASSWORD=secret

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Laravel Backend ---
APP_NAME=LLMora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# --- KlikQRIS ---
KLIKQRIS_API_KEY=your-klikqris-api-key
KLIKQRIS_MERCHANT_ID=your-klikqris-merchant-id
KLIKQRIS_WEBHOOK_URL=http://localhost:8000/api/payment/webhook

# --- Upstream (via 9router) ---
# Arsitektur: gateway → 9router (port 20128) → llm-proxy (port 9898) → OpenRouter.
# 9router me-route per model/pool, llm-proxy me-rotate trial keys.
# Untuk run lokal di luar docker, sudah benar pakai 127.0.0.1. Di docker compose
# nanti, ganti host ke nama service 9router (default 'router').
UPSTREAM_API_URL=http://127.0.0.1:20128/api/v1
# Kosong = no-auth. 9router membaca REQUIRE_API_KEY-nya sendiri (lihat 9router/.env).
UPSTREAM_API_KEY=
UPSTREAM_DEFAULT_MODEL=anthropic/claude-opus-4.7

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# --- Gateway ---
GATEWAY_PORT=3001
