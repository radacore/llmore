# ============================================
# LLMora.id — Environment Configuration
# ============================================

# --- Database (PostgreSQL) ---
DB_DATABASE=llmore
DB_USERNAME=llmore
DB_PASSWORD=secret

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Laravel Backend ---
APP_NAME=LLMora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/google/callback

# --- KlikQRIS ---
KLIKQRIS_API_KEY=your-klikqris-api-key
KLIKQRIS_MERCHANT_ID=your-klikqris-merchant-id
KLIKQRIS_WEBHOOK_URL=http://localhost:8000/api/payment/webhook

# --- Upstream LLM Proxy ---
# URL service llm-proxy (di docker compose ini berjalan sebagai service 'llm-proxy').
# Untuk run lokal di luar docker, ganti ke http://127.0.0.1:9898/v1
UPSTREAM_API_URL=http://llm-proxy:9898/v1
# Kosong = no-auth (default kalau llm-proxy hanya diakses dari internal network).
# Set kalau llm-proxy diexpose dan butuh proteksi (PROXY_API_KEY di llm-proxy-vps/.env).
UPSTREAM_API_KEY=
UPSTREAM_DEFAULT_MODEL=anthropic/claude-opus-4.7

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# --- Gateway ---
GATEWAY_PORT=3001
