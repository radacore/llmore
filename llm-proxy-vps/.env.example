# Konfigurasi LLM Proxy Router
HOST=0.0.0.0
PORT=9898

# Endpoint Alice trial activation
ALICE_TRIAL_URL=https://alice.overment.com/trial/activate
ALICE_TRIAL_CODE=TRIAL
ALICE_PLATFORM=windows — 10.0.26200
ALICE_VERSION=5.2.1

# OpenRouter
OPENROUTER_BASE=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-opus-4.7

# =============================================================================
# Pool & Concurrency (multi-agent / sub-agent friendly)
# =============================================================================

# Jumlah API key paralel di pool. 10 = paling aman menurut user.
POOL_SIZE=10

# Konkurensi per key (request bersamaan max per key).
# OpenCode dengan sub-agent biasanya spawn 5-10 task paralel; jangan terlalu
# kecil supaya tidak antri. 4 = aman untuk Opus, 8+ untuk model murah/free.
PER_KEY_CONCURRENCY=4

# Strategi load-balance saat memilih key:
#   least_inflight (default) — pilih key healthy dgn in_flight terkecil.
#                              recommended untuk OpenCode multi-agent: burst
#                              dari sub-agent paralel otomatis tersebar.
#   round_robin              — perilaku lama (sequential putar pool).
#   p2c                      — power-of-two-choices: random 2 key, pilih yg
#                              in_flight lebih kecil. Bagus untuk pool >>50.
LOAD_BALANCE_STRATEGY=least_inflight

# Detik tunggu slot key kosong saat semua key penuh (anti-thundering-herd).
# 0 = no wait (langsung 503). 30 = OpenCode burst akan ngantri max 30s.
ACQUIRE_TIMEOUT=30

# Hard cap total request bersamaan di proxy. 0 = auto (pool * per_key * 1.5).
MAX_CONCURRENT_REQUESTS=0

# Agent affinity: kalau client kirim header X-Agent-ID/X-Subagent-ID/X-Task-ID,
# proxy akan coba pakai key yg sama untuk request berturut-turut dari agent
# tersebut → bagus untuk prompt-caching di OpenRouter.
AGENT_AFFINITY=true

# =============================================================================
# Credit
# =============================================================================

# Threshold credit minimum (USD) sebelum key dianggap habis dan di-rotate.
# Default 0.10 = aman, key < $0.10 dihapus dari pool (hampir pasti 402).
MIN_CREDIT_USD=0.10

# Interval refresh credit (detik). Juga jadi interval ensure_credit_target.
CREDIT_REFRESH_INTERVAL=60

# =============================================================================
# Auto Credit Top-Up (VPS mode)
# =============================================================================
# Sistem auto bikin akun trial sampai total credit pool >= target.
# Trigger: (a) saat startup (background, non-blocking), (b) tiap CREDIT_REFRESH_INTERVAL.
#
# Flow: total < REFILL_THRESHOLD_USD -> bikin akun baru sampai total >= TARGET.

# Target total credit pool (USD). Pool akan auto-create akun trial untuk
# mencapai angka ini.
TARGET_TOTAL_CREDIT_USD=500

# Threshold refill. Kalau total credit pool turun di bawah ini, akan refill
# kembali ke TARGET. HARUS < TARGET_TOTAL_CREDIT_USD.
REFILL_THRESHOLD_USD=400

# Concurrency saat bulk-create akun trial. Jangan terlalu tinggi (Alice bisa
# rate-limit / IP-ban). 8 = aman.
TRIAL_CREATE_CONCURRENCY=8

# Circuit breaker: kalau N aktivasi gagal beruntun, pause aktivasi sementara.
TRIAL_FAILURE_THRESHOLD=10

# Durasi cooldown circuit breaker (detik) sebelum boleh coba aktivasi lagi.
TRIAL_FAILURE_COOLDOWN_S=300

# Hard ceiling jumlah total key di pool. Proteksi infinite loop kalau credit
# per trial tiba-tiba kecil dan tidak konvergen ke target.
POOL_CEILING=1000

# =============================================================================
# HTTP pool (tuning untuk multi-agent paralel)
# =============================================================================

# Ukuran pool koneksi httpx ke OpenRouter. Harus jauh > total in-flight
# supaya tidak jadi bottleneck saat banyak sub-agent paralel.
HTTP_MAX_CONNECTIONS=500
HTTP_MAX_KEEPALIVE=200
HTTP_KEEPALIVE_EXPIRY=60

# =============================================================================
# Auth & storage
# =============================================================================

# Proxy auth (opsional). Kosongkan untuk no-auth.
PROXY_API_KEY=

# File penyimpanan pool key (JSON)
KEYS_DB_PATH=./data/keys.json
