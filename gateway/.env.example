# Server
GATEWAY_PORT=3001
NODE_ENV=development

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Upstream LLM Proxy (internal — di docker compose ini = service llm-proxy)
UPSTREAM_API_URL=http://llm-proxy:9898/v1
# Kosongkan kalau llm-proxy berjalan tanpa PROXY_API_KEY (default internal docker network)
UPSTREAM_API_KEY=
# Default model OpenRouter yang dipakai kalau client tidak menyebut model
UPSTREAM_DEFAULT_MODEL=anthropic/claude-opus-4.7

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
